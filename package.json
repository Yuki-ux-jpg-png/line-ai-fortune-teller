{
  "name": "line-fortune-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "tsx src/migrate.ts",
    "check:schema": "node scripts/check-worker-schema.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check:worker-health": "node scripts/check-worker-health.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "6.2.15",
    "nodemailer": "10.4.0",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "stripe": "^22.4.0",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "@types/web-push": "3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
