{
  "name": "line-fortune-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "tsx src/migrate.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "stripe": "^22.4.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
