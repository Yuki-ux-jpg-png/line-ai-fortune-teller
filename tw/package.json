{
  "name": "line-fortune-bot-tw",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/migrate.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "tsx src/migrate.ts",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
